{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "asan-ubsan",
      "displayName": "link2symlink ASan + UBSan CI build",
      "description": "Standalone host build and smoke test with address and undefined-behavior sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LINK2SYMLINK_ENABLE_SANITIZERS": "ON",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
