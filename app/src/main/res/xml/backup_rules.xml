<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="network_connections_prefs.xml"/>
    <exclude domain="sharedpref" path="network_connections_credentials.xml"/>
    <exclude domain="sharedpref" path="vault_prefs.xml"/>
    <exclude domain="file" path="sftp_known_hosts"/>
    <exclude domain="file" path="vault/"/>
    <exclude domain="file" path="webshare/id_rsa.pem"/>
    <exclude domain="file" path="webshare/localhost.run.pub"/>
</full-backup-content>