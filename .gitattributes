# Normalize text files while preserving platform-specific executable conventions.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Prebuilt and media assets must never be line-ending converted.
*.apk binary
*.aab binary
*.aar binary
*.jar binary
*.so binary
*.zip binary
*.xz binary
*.7z binary
*.onnx binary
*.tflite binary
*.bundle binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Third-party source retained from the upstream project.
app/src/main/java/com/ahmadullahpk/alldocumentreader/xs/** linguist-vendored
